passive
ipcp-accept-remote
proxyarp
user MyL2tpRouter
name MyL2tpRouter
remotename MyL2tpServer
require-mschap-v2
ipparam "<L2TP_SERVER_ADDR>"
persist
mtu 1460
mru 1460
noipv6
connect-delay 5000
usepeerdns
ktune